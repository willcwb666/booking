# Banco de dados (Docker)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="ALTERE_ISSO"
POSTGRES_DB="booking"
DATABASE_URL="postgresql://POSTGRES_USER:POSTGRES_PASSWORD@127.0.0.1:5433/POSTGRES_DB?schema=public"

# Cache
REDIS_URL="redis://localhost:6379"

# Better Auth
BETTER_AUTH_URL="http://localhost:3000"
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Login com Google (opcional — sem isso o botão do Google não aparece)
# Console: https://console.cloud.google.com/apis/credentials
# Redirect URI autorizada: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudflare R2 / S3 (Upload de Logos e Avatares)
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="booking-uploads"
R2_PUBLIC_URL="https://pub-<HASH>.r2.dev"

# Stripe — pagamentos de bookings E assinaturas de planos (Billing)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Webhook: eventos payment_intent.* (bookings) + checkout.session.completed
# e customer.subscription.* (assinaturas). Configure em dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=""
# Moeda de cobrança das assinaturas de planos (ISO 4217 minúsculo). Padrão: brl
PLATFORM_BILLING_CURRENCY="brl"

# SMS Reminders (Twilio ou Gateway Gratuito)
# Twilio fornece créditos gratuitos ao criar a conta:
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""
# Ou Gateway HTTP Gratuito / Próprio:
SMS_API_URL=""
SMS_API_KEY=""

