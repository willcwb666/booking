generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum BusinessType {
  HOME_CLEANING
  PET_GROOMER
  CAR_WASH
  POOL_CLEANING
  LAWN_CARE
  BARBER
  HAIR_SALON
  PHOTOGRAPHER
  MECHANIC
  OTHER
}

enum CompanyUserRole {
  OWNER
  MANAGER
  EMPLOYEE
}

enum AgendaStatus {
  DRAFT
  ACTIVE
  CANCELLED
}

enum BookingConfigStatus {
  DRAFT
  PUBLISHED
}

enum ScheduleEventType {
  APPOINTMENT
  EVENT
  ESTIMATE
}

enum EstimateStatus {
  DRAFT
  PENDING
  CONVERTED
  CANCELLED
}

enum EstimateFrequency {
  ONCE
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum PaymentMethod {
  CARD
  CASH_CHECK
  PIX
}

// Como o pagamento é processado/confirmado:
// STRIPE_CARD / MERCADOPAGO_PIX → confirmação automática via webhook do gateway
// MANUAL → cliente paga por fora (dinheiro, PIX por chave, Zelle, Venmo, …)
//          e o dono confirma o recebimento no painel
enum PaymentKind {
  STRIPE_CARD
  MERCADOPAGO_PIX
  MANUAL
}

enum AgendaExceptionType {
  BLOCKED_DAY
  CUSTOM_HOURS
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  BOOKED
  EXPIRED
}

enum CalendarProvider {
  GOOGLE
  APPLE
  ICAL_FEED
}

enum WebhookEvent {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  BOOKING_RESCHEDULED
  REVIEW_SUBMITTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ─── Auth (better-auth) ───────────────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // better-auth admin plugin
  role             String?
  banned           Boolean?  @default(false)
  // better-auth twoFactor plugin
  twoFactorEnabled Boolean?  @default(false)
  banReason        String?
  banExpires       DateTime?

  // perfil customizado
  bio      String?
  location String?

  // Multiempresas: permite cadastrar mais de uma empresa (cada uma com
  // assinatura de plano cobrada individualmente)
  allowMultiCompany Boolean @default(false)

  sessions                 Session[]
  accounts                 Account[]
  companyUsers             CompanyUser[]
  professionals            Professional[]
  createdAgendas           Agenda[]                    @relation("AgendaCreatedBy")
  cancelledAgendas         Agenda[]                    @relation("AgendaCancelledBy")
  createdBookingConfigs    BookingConfig[]             @relation("BookingConfigCreatedBy")
  createdScheduleEvents    ScheduleEvent[]             @relation("ScheduleEventCreatedBy")
  estimatesAsCustomer      Estimate[]                  @relation("EstimateCustomer")
  cancelledBookings        Booking[]                   @relation("BookingCancelledBy")
  confirmedPayments        Booking[]                   @relation("BookingPaymentConfirmedBy")
  pushTokens               PushToken[]
  notificationPrefs        UserNotificationPreference?
  profile                  UserProfile?
  calendarIntegrations     CalendarIntegration[]
  twoFactors               TwoFactor[]
  twoFactorResetsAsTarget  TwoFactorResetRequest[]     @relation("TwoFactorResetTarget")
  twoFactorResetsRequested TwoFactorResetRequest[]     @relation("TwoFactorResetRequester")
  photoConsentsCollected   ClientPhoto[]               @relation("ClientPhotoConsentBy")

  @@unique([email])
  @@map("user")
}

/**
 * Dados pessoais do usuário — o "Kreator Pass".
 * ─── Por que aqui e não copiando de outra empresa ────────────────────────────
 * O desenho original preenchia o formulário do Pet Shop com os dados que a
 * cliente havia informado ao Salão. Isso é transferência de dado pessoal entre
 * dois controladores distintos: o Salão coletou aqueles dados para a própria
 * finalidade e não autorizou repasse. Modal de consentimento não resolve —
 * quem precisaria consentir é o Salão, não só a cliente.
 * Com o perfil pertencendo ao USUÁRIO, nada atravessa empresas. A pessoa
 * preenche o formulário com os próprios dados, que é exatamente o que o
 * autofill do navegador faz. Some o problema jurídico e some o modal junto.
 * O `Customer` de cada empresa continua sendo criado no primeiro agendamento,
 * com os dados copiados naquele momento. Editar a ficha no Salão não altera
 * este perfil nem a ficha do Pet Shop.
 */
model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String?
  lastName  String?
  phone     String?
  address   String?
  aptNo     String?
  city      String?
  zip       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profile")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  // ─── Política de sessão (idle timeout + sessão única) ───
  // Origem da sessão. "WEB" = navegador (sujeito a sessão única e idle curto),
  // "MOBILE" = app nativo (política própria, mais frouxa). Definido no
  // databaseHook de criação a partir do header `x-client`.
  client         String   @default("WEB")
  // Último acesso autenticado observado. Base do timeout de inatividade —
  // NÃO usar `updatedAt`, que o better-auth mexe só a cada `updateAge`.
  lastActivityAt DateTime @default(now())

  @@unique([token])
  @@index([userId])
  @@index([userId, client])
  @@map("session")
}

/// Fila de saída de notificações.
///
/// Antes, confirmações e lembretes eram disparados com `void notify…(id)`:
/// sem await, sem fila, sem retry e sem registro. Se o provedor de e-mail
/// desse timeout, a confirmação simplesmente não acontecia e ninguém ficava
/// sabendo — que é exatamente a reclamação mais comum contra os concorrentes
/// ("o cliente não recebeu", "o lembrete parou de funcionar sozinho").
///
/// Agora a intenção de notificar é gravada na MESMA transação do agendamento.
/// Um worker consome com backoff, e o que falhou fica visível.
model NotificationOutbox {
  id            String    @id @default(cuid())
  /// Ex.: BOOKING_CONFIRMED, BOOKING_REMINDER, COMPANY_NEW_BOOKING
  kind          String
  bookingId     String?
  companyId     String?
  /// JSON com argumentos extras do disparo (ex.: novo status)
  payload       String?
  /// PENDING | SENT | FAILED
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  lastError     String?
  /// Backoff: só é elegível a partir deste instante
  nextAttemptAt DateTime  @default(now())
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([bookingId])
  @@map("notification_outbox")
}

/// Configurações globais da plataforma (chave/valor), editadas pelo super admin.
/// Antes esta tabela era criada em runtime via `CREATE TABLE IF NOT EXISTS` —
/// agora é um model versionado por migration.
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt

  @@map("system_setting")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/**
 * Segredo TOTP e códigos de recuperação — tabela do plugin `twoFactor`.
 * O nome das colunas é ditado pelo plugin, não por nós: `backupCodes` guarda a
 * lista serializada e criptografada, e o better-auth queima cada código no uso.
 * Escrever isso à mão seria reimplementar o que já veio no pacote.
 */
model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

/**
 * Pedido de reset da verificação em duas etapas pelo super admin.
 * É um backdoor legítimo — o dono que perdeu o celular E o acesso ao e-mail
 * precisa de alguém que destranque a conta. Mas sem freio ele significa que a
 * segurança de TODOS os tenants vale exatamente a segurança de uma conta
 * pessoal: quem tomar o super admin toma qualquer empresa em silêncio.
 * Os três freios estão aqui: o pedido não executa na hora (`executeAfter`), o
 * dono é avisado no momento do PEDIDO e não da execução, e ele mesmo pode
 * cancelar enquanto ainda conseguir entrar. Um super admin sequestrado passa a
 * ter 24 horas de janela visível em vez de acesso imediato e mudo.
 */
model TwoFactorResetRequest {
  id            String    @id @default(cuid())
  targetUserId  String
  targetUser    User      @relation("TwoFactorResetTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User      @relation("TwoFactorResetRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reason        String
  /// PENDING | EXECUTED | CANCELLED
  status        String    @default("PENDING")
  /// Não pode ser executado antes deste instante.
  executeAfter  DateTime
  executedAt    DateTime?
  cancelledAt   DateTime?
  /// Quem cancelou — o próprio dono, ou outro super admin que revisou o pedido.
  cancelledById String?
  createdAt     DateTime  @default(now())

  @@index([targetUserId, status])
  @@index([status, executeAfter])
  @@map("two_factor_reset_request")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Plans ────────────────────────────────────────────────────────────────────

model Plan {
  id                   String        @id @default(cuid())
  // Código único do plano (livre); antes era enum PlanTier, agora String para
  // permitir o cadastro de planos arbitrários pelo super admin
  tier                 String        @unique
  displayName          String
  description          String?
  priceMonthly         Decimal       @db.Decimal(10, 2)
  priceYearly          Decimal       @db.Decimal(10, 2)
  isActive             Boolean       @default(true)
  order                Int           @default(0)
  // Stripe Billing — sincronizado ao salvar o plano no admin
  stripeProductId      String?
  stripePriceMonthlyId String?
  stripePriceYearlyId  String?
  isPopular            Boolean?      @default(false)
  features             PlanFeature[]
  companies            Company[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("plan")
}

model PlanFeature {
  id           String  @id @default(cuid())
  planId       String
  plan         Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureKey   String
  featureLabel String
  enabled      Boolean @default(true)
  limitValue   Int?

  @@unique([planId, featureKey])
  @@index([planId])
  @@map("plan_feature")
}

// ─── Tenant ───────────────────────────────────────────────────────────────────

model Company {
  id                         String                  @id @default(cuid())
  name                       String
  slug                       String                  @unique
  businessType               String
  planId                     String
  plan                       Plan                    @relation(fields: [planId], references: [id])
  logoUrl                    String?
  phone                      String?
  address                    String?
  isActive                   Boolean                 @default(true)
  // Token secreto para o feed público de calendário (.ics) — sem ele o feed
  // exporia PII (nomes/telefones) só com o slug da empresa
  calendarFeedToken          String?                 @unique
  // Internacionalização — cada empresa opera em um mercado
  currency                   String                  @default("BRL") // ISO 4217 (BRL, USD, …)
  timezone                   String                  @default("America/Sao_Paulo") // IANA
  locale                     String                  @default("pt-BR") // BCP 47
  // Assinatura do plano (Stripe Billing) — cobrança individual por empresa
  stripeCustomerId           String?
  stripeSubscriptionId       String?
  subscriptionStatus         String? // active | trialing | past_due | canceled | …
  subscriptionInterval       String? // month | year
  subscriptionPeriodEnd      DateTime? // fim do período pago atual (base do dunning)
  // Política de cancelamento (configurável por empresa)
  minCancellationNoticeHours Int                     @default(24)
  cancellationFee            Decimal                 @default(0) @db.Decimal(10, 2)
  lateToleranceMinutes       Int                     @default(15)
  maxAllowedNoShows          Int                     @default(2)
  // Check-in por proximidade. Sem coordenadas o geofence é PULADO — antes o
  // código comparava a posição do cliente com um ponto fixo em Curitiba,
  // então qualquer empresa fora de lá reprovava todo mundo.
  latitude                   Float?
  longitude                  Float?
  checkinRadiusMeters        Int                     @default(250)
  // Buffer de deslocamento entre atendimentos a domicílio. Desligado por
  // padrão: para quem atende no balcão, reservar tempo de viagem só apagaria
  // horários vendáveis da grade.
  driveTimeEnabled           Boolean                 @default(false)
  // Minutos por quilômetro EM LINHA RETA — não por quilômetro de rua. O
  // padrão de 3 (20 km/h) já absorve o desvio das ruas em relação à reta,
  // que é justamente o erro que a haversine comete.
  driveTimeMinutesPerKm      Float                   @default(3)
  // Teto do buffer. Um endereço mal geocodificado — o serviço devolve o
  // centroide da cidade errada — produziria uma reta de centenas de km e
  // apagaria o dia inteiro da grade. O teto transforma erro de dado em erro
  // limitado.
  driveTimeMaxMinutes        Int                     @default(120)
  // Meses de guarda das fotos de cliente antes do expurgo automático. Guardar
  // rosto de pessoa identificada sem prazo não se defende em auditoria — e o
  // custo de armazenamento de dado sensível cresce para sempre.
  photoRetentionMonths       Int                     @default(24)
  // Ranking de faturamento visível para a equipe inteira. DESLIGADO por padrão,
  // e a razão está na tela: expor o ranking é decisão de gestão, não de
  // software. Desmotiva a metade de baixo e pressiona upsell — que degrada a
  // experiência do cliente justamente onde a recorrência é o ativo.
  showTeamRanking            Boolean                 @default(false)
  // Notificações e Canais
  notifyEmailEnabled         Boolean                 @default(true)
  notifyTextEnabled          Boolean                 @default(true)
  notifySmsEnabled           Boolean                 @default(false)
  notifyWhatsappEnabled      Boolean                 @default(true)
  // Customização da Landing Page Pública
  heroTitle                  String?
  heroSubtitle               String?
  brandColor                 String?                 @default("#0f172a")
  coverImageUrl              String?
  // Link "escrever avaliação" do Google Meu Negócio.
  //
  // O pedido de avaliação convida TODO MUNDO para cá, independente da nota.
  // Filtrar quem avaliou mal antes do Google ("review gating") viola a política
  // do Google Business Profile e a regra da FTC de 2024 — a punição possível é
  // a remoção do perfil da empresa do Maps.
  googleReviewUrl            String?
  socialInstagram            String?
  socialWhatsapp             String?
  socialFacebook             String?
  members                    CompanyUser[]
  services                   Service[]
  serviceTypes               ServiceType[]
  extraServices              ExtraService[]
  professionals              Professional[]
  agendas                    Agenda[]
  bookingConfigs             BookingConfig[]
  scheduleEvents             ScheduleEvent[]
  estimates                  Estimate[]
  bookings                   Booking[]
  reviews                    Review[]
  paymentSettings            CompanyPaymentSettings?
  paymentMethods             CompanyPaymentMethod[]
  waitlistEntries            WaitlistEntry[]
  webhooks                   CompanyWebhook[]
  promotions                 Promotion[]
  loyaltyProgram             LoyaltyProgram?
  loyaltyAccounts            LoyaltyAccount[]
  customers                  Customer[]
  membershipPlans            MembershipPlan[]
  customerMemberships        CustomerMembership[]
  giftCards                  GiftCard[]
  products                   Product[]
  posSales                   PosSale[]
  offPeakWindows             OffPeakWindow[]
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  clientPhotos               ClientPhoto[]
  serviceRecords             ServiceRecord[]

  @@map("company")
}

model CompanyUser {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CompanyUserRole @default(EMPLOYEE)
  isActive  Boolean         @default(true)
  joinedAt  DateTime        @default(now())

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@map("company_user")
}

// ─── Catalog ──────────────────────────────────────────────────────────────────

model Service {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  icon         String        @default("scissors")
  isActive     Boolean       @default(true)
  order        Int           @default(0)
  serviceTypes ServiceType[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([companyId])
  @@index([companyId, isActive])
  @@map("service")
}

model ServiceType {
  id               String                     @id @default(cuid())
  companyId        String
  company          Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceId        String
  service          Service                    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  price            Decimal                    @db.Decimal(10, 2)
  estimatedMinutes Int
  // Quando true, o cliente informa a quantidade ao selecionar (ex.: nº de pneus)
  allowQuantity    Boolean                    @default(false)
  isActive         Boolean                    @default(true)
  order            Int                        @default(0)
  bookingConfigs   BookingConfigServiceType[]
  estimateItems    EstimateServiceType[]
  promotions       Promotion[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([companyId])
  @@index([serviceId])
  @@index([companyId, isActive])
  @@map("service_type")
}

model ExtraService {
  id               String                      @id @default(cuid())
  companyId        String
  company          Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  price            Decimal                     @db.Decimal(10, 2)
  estimatedMinutes Int
  icon             String                      @default("sparkles")
  allowQuantity    Boolean                     @default(false)
  isActive         Boolean                     @default(true)
  order            Int                         @default(0)
  bookingConfigs   BookingConfigExtraService[]
  estimateItems    EstimateExtraService[]
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([companyId])
  @@index([companyId, isActive])
  @@map("extra_service")
}

model Professional {
  id                    String   @id @default(cuid())
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                  String
  email                 String?
  phone                 String?
  bio                   String?
  avatarUrl             String?
  // Meta de faturamento do dia. Nula = sem meta, e a tela mostra o resultado
  // sem barra de progresso: barra contra meta zero seria 100% todo dia.
  dailyGoal             Decimal? @db.Decimal(10, 2)
  commissionPercentage  Float    @default(0)
  commissionRate        Decimal? @default(0) @db.Decimal(5, 2)
  productCommissionRate Decimal? @default(0) @db.Decimal(5, 2)
  pixKey                String?
  pixKeyType            String?
  roleTitle             String?
  servicesJson          String?
  showOnLanding         Boolean? @default(true)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  agendas        AgendaProfessional[]
  scheduleEvents ScheduleEvent[]
  bookings       Booking[]
  clientPhotos   ClientPhoto[]
  serviceRecords ServiceRecord[]

  @@index([companyId])
  @@index([companyId, isActive])
  @@map("professional")
}

// ─── Agendas ──────────────────────────────────────────────────────────────────

model Agenda {
  id                 String               @id @default(cuid())
  companyId          String
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String
  status             AgendaStatus         @default(DRAFT)
  startDate          String // "YYYY-MM-DD"
  endDate            String? // "YYYY-MM-DD"
  workingDays        Int[]
  startTime          String // "HH:MM"
  endTime            String // "HH:MM"
  intervalMinutes    Int
  cancelledAt        DateTime?
  cancelledById      String?
  cancelledBy        User?                @relation("AgendaCancelledBy", fields: [cancelledById], references: [id])
  cancellationReason String?
  createdById        String
  createdBy          User                 @relation("AgendaCreatedBy", fields: [createdById], references: [id])
  professionals      AgendaProfessional[]
  bookingConfigs     BookingConfig[]
  bookings           Booking[]
  bookingSlots       BookingSlot[]
  exceptions         AgendaException[]
  waitlistEntries    WaitlistEntry[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([companyId, status])
  @@index([companyId, startDate])
  @@map("agenda")
}

model AgendaProfessional {
  agendaId       String
  agenda         Agenda       @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@id([agendaId, professionalId])
  @@index([agendaId])
  @@index([professionalId])
  @@map("agenda_professional")
}

// ─── Booking Config ───────────────────────────────────────────────────────────

model BookingConfig {
  id                  String                      @id @default(cuid())
  companyId           String
  company             Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agendaId            String
  agenda              Agenda                      @relation(fields: [agendaId], references: [id])
  name                String
  status              BookingConfigStatus         @default(DRAFT)
  allowPartialService Boolean                     @default(false)
  createdById         String
  createdBy           User                        @relation("BookingConfigCreatedBy", fields: [createdById], references: [id])
  serviceTypes        BookingConfigServiceType[]
  extraServices       BookingConfigExtraService[]
  estimates           Estimate[]
  bookings            Booking[]
  waitlistEntries     WaitlistEntry[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@index([companyId, status])
  @@index([agendaId])
  @@map("booking_config")
}

model BookingConfigServiceType {
  bookingConfigId String
  bookingConfig   BookingConfig @relation(fields: [bookingConfigId], references: [id], onDelete: Cascade)
  serviceTypeId   String
  serviceType     ServiceType   @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  @@id([bookingConfigId, serviceTypeId])
  @@index([bookingConfigId])
  @@index([serviceTypeId])
  @@map("booking_config_service_type")
}

model BookingConfigExtraService {
  bookingConfigId String
  bookingConfig   BookingConfig @relation(fields: [bookingConfigId], references: [id], onDelete: Cascade)
  extraServiceId  String
  extraService    ExtraService  @relation(fields: [extraServiceId], references: [id], onDelete: Cascade)

  @@id([bookingConfigId, extraServiceId])
  @@index([bookingConfigId])
  @@index([extraServiceId])
  @@map("booking_config_extra_service")
}

// ─── Schedule ─────────────────────────────────────────────────────────────────

model ScheduleEvent {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professionalId  String?
  professional    Professional?     @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  title           String
  type            ScheduleEventType @default(EVENT)
  date            String // "YYYY-MM-DD"
  startTime       String // "HH:MM"
  endTime         String // "HH:MM"
  notes           String?
  externalEventId String? // ID do evento no Google Calendar ou UID do iCal
  source          String?           @default("MANUAL") // MANUAL | GOOGLE_CALENDAR | ICAL_FEED | DRIVE_TIME
  // Opcional porque o bloqueio de deslocamento não tem autor: ninguém o
  // criou. Carimbar o dono da empresa como criador de um bloco que o sistema
  // gerou sozinho seria mentira no rastro de auditoria.
  createdById     String?
  createdBy       User?             @relation("ScheduleEventCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime          @default(now())

  @@index([companyId, date])
  @@index([professionalId, date])
  @@index([companyId, externalEventId])
  @@map("schedule_event")
}

/// Endereço já resolvido em coordenadas.
///
/// O geocodificador é um serviço público, gratuito e mantido por voluntários:
/// consultar o mesmo endereço a cada agendamento de um cliente recorrente é
/// desperdiçar a cota de todo mundo e um convite a ser bloqueado. Aqui cada
/// endereço distinto custa uma consulta na vida.
///
/// Falha também é cacheada, com `latitude`/`longitude` nulas: sem isso, um
/// endereço que o serviço não reconhece seria reconsultado a cada agendamento
/// para sempre. `resolvedAt` permite reexpirar a falha — endereço novo pode
/// entrar na base do provedor depois.
model GeocodeCache {
  /// Endereço normalizado (minúsculas, espaços colapsados) — a chave.
  query      String   @id
  latitude   Float?
  longitude  Float?
  provider   String
  resolvedAt DateTime @default(now())

  @@map("geocode_cache")
}

// ─── Estimate ─────────────────────────────────────────────────────────────────

model Estimate {
  id              String                 @id @default(cuid())
  companyId       String
  company         Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bookingConfigId String
  bookingConfig   BookingConfig          @relation(fields: [bookingConfigId], references: [id])
  customerId      String?
  customer        User?                  @relation("EstimateCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  customerEmail   String?
  customerName    String?
  status          EstimateStatus         @default(DRAFT)
  frequency       EstimateFrequency      @default(ONCE)
  subtotal        Decimal                @db.Decimal(10, 2)
  total           Decimal                @db.Decimal(10, 2)
  // Moeda cobrada NO ATO. Sem esta coluna o valor herdava a moeda atual da
  // empresa na hora da leitura: trocar `Company.currency` reinterpretava todo
  // o histórico em silêncio (R$ 4.000 viravam $4.000 no relatório).
  // Nulo = registro anterior à coluna; a leitura cai em `Company.currency`.
  currency        String? // ISO 4217
  notes           String?
  serviceTypes    EstimateServiceType[]
  extraServices   EstimateExtraService[]
  bookings        Booking[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([bookingConfigId, status])
  @@index([customerId, status])
  // Painel da plataforma agrega receita por moeda.
  @@index([companyId, currency])
  @@map("estimate")
}

model EstimateServiceType {
  id            String      @id @default(cuid())
  estimateId    String
  estimate      Estimate    @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  serviceTypeId String
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])
  quantity      Int
  unitPrice     Decimal     @db.Decimal(10, 2)
  subtotal      Decimal     @db.Decimal(10, 2)

  @@index([estimateId])
  @@map("estimate_service_type")
}

model EstimateExtraService {
  id             String       @id @default(cuid())
  estimateId     String
  estimate       Estimate     @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  extraServiceId String
  extraService   ExtraService @relation(fields: [extraServiceId], references: [id])
  quantity       Int
  unitPrice      Decimal      @db.Decimal(10, 2)
  subtotal       Decimal      @db.Decimal(10, 2)

  @@index([estimateId])
  @@map("estimate_extra_service")
}

// ─── Booking ──────────────────────────────────────────────────────────────────

model Booking {
  id                     String                 @id @default(cuid())
  companyId              String
  company                Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  estimateId             String?                @unique
  estimate               Estimate?              @relation(fields: [estimateId], references: [id])
  bookingConfigId        String
  bookingConfig          BookingConfig          @relation(fields: [bookingConfigId], references: [id])
  agendaId               String
  agenda                 Agenda                 @relation(fields: [agendaId], references: [id])
  professionalId         String?
  professional           Professional?          @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  scheduledDate          String // "YYYY-MM-DD"
  scheduledStartTime     String // "HH:MM"
  scheduledEndTime       String // "HH:MM"
  status                 BookingStatus          @default(PENDING)
  paymentMethod          PaymentMethod
  paymentStatus          PaymentStatus          @default(PENDING)
  // Forma de pagamento configurada escolhida no checkout (label/handle/kind).
  // O enum paymentMethod permanece como discriminador de fluxo legado.
  companyPaymentMethodId String?
  companyPaymentMethod   CompanyPaymentMethod?  @relation(fields: [companyPaymentMethodId], references: [id], onDelete: SetNull)
  // Confirmação manual de recebimento (métodos MANUAL)
  paidAt                 DateTime?
  paymentConfirmedById   String?
  paymentConfirmedBy     User?                  @relation("BookingPaymentConfirmedBy", fields: [paymentConfirmedById], references: [id])
  stripePaymentIntentId  String?
  mercadoPagoPaymentId   String?
  cancelledAt            DateTime?
  cancelledById          String?
  cancelledBy            User?                  @relation("BookingCancelledBy", fields: [cancelledById], references: [id])
  cancellationReason     String?
  refundAmount           Decimal?               @db.Decimal(10, 2)
  /// Marca de que os pontos de fidelidade deste atendimento já foram creditados.
  /// Ponto é moeda: sem esta marca, concluir o mesmo atendimento duas vezes
  /// creditava duas vezes.
  loyaltyAwardedAt       DateTime?
  /// Comissão do profissional, CARIMBADA na conclusão do atendimento.
  ///
  /// Sem ela, o extrato recalculava com a taxa ATUAL do profissional — e mudar
  /// a taxa reescrevia retroativamente o que ele já tinha ganhado. A venda de
  /// balcão já carimbava desde `c01e462`; o agendamento ficou como dívida
  /// anotada, e é esta.
  commissionAmount       Decimal?               @db.Decimal(10, 2)
  /// A taxa aplicada no momento da conclusão. Guardada junto do valor para o
  /// extrato poder explicar a conta, não só exibir o resultado.
  commissionRate         Decimal?               @db.Decimal(5, 2)
  refundedAt             DateTime?
  // Chegada confirmada pelo cliente. Sem este campo o check-in não deixava
  // rastro: o estado "já fez check-in" era inalcançável e o operador não
  // tinha como saber quem chegou.
  checkedInAt            DateTime?
  // Pedido de avaliação já enviado — impede reenvio a cada reprocessamento.
  reviewRequestedAt      DateTime?
  // Rescheduling
  rescheduledFromId      String?
  rescheduledFrom        Booking?               @relation("RescheduledFrom", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo          Booking[]              @relation("RescheduledFrom")
  rescheduledAt          DateTime?
  // Customer link
  customerId             String?
  customer               Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // Recurrence
  recurrenceGroupId      String?
  recurrenceFrequency    EstimateFrequency?
  recurrenceEndDate      String?
  slots                  BookingSlot[]
  customerDetail         BookingCustomerDetail?
  homeAccess             BookingHomeAccess?
  review                 Review?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  clientPhotos           ClientPhoto[]
  serviceRecord          ServiceRecord?

  @@index([companyId, scheduledDate])
  @@index([companyId, customerId])
  @@index([agendaId, scheduledDate])
  // Agenda individual do profissional e relatório de comissão filtram por
  // profissional + data; sem este índice a consulta caía no índice de agenda
  // e filtrava o resto em memória.
  @@index([professionalId, scheduledDate])
  @@map("booking")
}

model BookingSlot {
  id             String  @id @default(cuid())
  /// Um agendamento ocupa TANTOS slots quanto os serviços dele exigem.
  ///
  /// Era `@unique`, um slot por agendamento — e por isso um orçamento de 90
  /// minutos ocupava um slot de 30 na grade, deixando os dois seguintes à
  /// venda enquanto o profissional ainda estava trabalhando.
  bookingId      String
  booking        Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  agendaId       String
  agenda         Agenda  @relation(fields: [agendaId], references: [id])
  date           String // "YYYY-MM-DD"
  startTime      String // "HH:MM"
  endTime        String // "HH:MM"
  // Profissional que ocupa o slot. String vazia = agenda sem equipe (recurso
  // único). NUNCA null: em Postgres dois NULLs são distintos num índice único,
  // o que anularia a trava de duplo agendamento.
  professionalId String  @default("")

  // A trava de duplo agendamento é POR PROFISSIONAL — sem isso uma barbearia
  // com 3 barbeiros só conseguiria vender um horário das 10:00.
  @@unique([agendaId, date, startTime, professionalId])
  @@index([agendaId, date])
  @@index([bookingId])
  @@map("booking_slot")
}

model BookingCustomerDetail {
  id            String  @id @default(cuid())
  bookingId     String  @unique
  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  email         String
  phone         String
  sendReminders Boolean @default(true)
  address       String
  aptNo         String?
  city          String
  zip           String
  // Coordenadas resolvidas do endereço acima, uma vez, na criação. Nulas
  // quando o endereço não foi geocodificado (empresa sem buffer ligado,
  // serviço fora do ar, endereço que o geocodificador não reconheceu) — e
  // nesse caso o atendimento simplesmente não gera bloqueio de viagem.
  latitude      Float?
  longitude     Float?

  @@map("booking_customer_detail")
}

model BookingHomeAccess {
  id                  String  @id @default(cuid())
  bookingId           String  @unique
  booking             Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  accessType          String // "someone_home" | "hide_keys"
  keepKeyWithProvider Boolean @default(false)
  accessNote          String? // AES-256-GCM encrypted
  additionalNote      String?

  @@map("booking_home_access")
}

// ─── Customer ─────────────────────────────────────────────────────────────────

model Customer {
  id                 String    @id @default(cuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName          String
  lastName           String
  email              String
  phone              String
  city               String?
  notes              String?
  totalBookings      Int       @default(0)
  completedBookings  Int       @default(0)
  cancelledBookings  Int       @default(0)
  noShowCount        Int       @default(0)
  totalSpent         Decimal   @default(0) @db.Decimal(10, 2)
  lastBookingDate    String?
  // Última campanha de resgate enviada a este cliente. Sem isso, cada abertura
  // da tela reofereceria o mesmo desconto a quem já recebeu ontem — que é como
  // uma ferramenta de retenção vira motivo de descadastro.
  lastWinBackAt      DateTime?
  // Consentimento para e-mail de oferta, dado no checkout.
  //
  // Vive aqui e não em `UserNotificationPreference` porque a maioria dos
  // clientes agenda SEM criar conta — não existe `user` para pendurar a
  // preferência. Sem este campo, "quem nunca teve a chance de escolher" e
  // "quem escolheu não receber" eram indistinguíveis, e o sistema mandava
  // marketing para quem nunca consentiu.
  acceptsMarketing   Boolean   @default(false)
  marketingConsentAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  bookings       Booking[]
  photos         ClientPhoto[]
  serviceRecords ServiceRecord[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([companyId, phone])
  @@index([companyId, acceptsMarketing])
  @@map("customer")
}

/// Foto de antes/depois de um atendimento.
///
/// ─── O que NÃO existe aqui, de propósito ─────────────────────────────────────
///
/// Não há campo de "autorização para uso público", e não há galeria pública.
/// Rosto de pessoa identificada é dado pessoal sensível nas duas jurisdições em
/// que o produto opera, e a forma de garantir que uma foto dessas nunca apareça
/// numa landing page é não construir o caminho até lá. Um portfólio público,
/// se um dia existir, precisa de um consentimento próprio, colhido em separado
/// e para essa finalidade — não do reaproveitamento deste.
///
/// ─── Chave, não URL ──────────────────────────────────────────────────────────
///
/// Guarda-se a chave do objeto no R2, nunca uma URL pública. A leitura passa
/// por URL assinada de vida curta, gerada no servidor para quem tem acesso à
/// empresa. Uma URL pública com nome aleatório é segredo por obscuridade: basta
/// ela vazar em um print, um log ou o histórico do navegador para a foto ficar
/// acessível a qualquer um, para sempre.
model ClientPhoto {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookingId      String?
  booking        Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  /// Chave do objeto no armazenamento. NUNCA uma URL pública.
  storageKey     String        @unique
  /// BEFORE | AFTER
  kind           String
  caption        String?
  /// Consentimento desta foto, com data e com quem o colheu. Sem os dois a
  /// foto não é gravada: consentimento sem registro é o mesmo que nenhum.
  consentAt      DateTime
  consentById    String
  consentBy      User          @relation("ClientPhotoConsentBy", fields: [consentById], references: [id])
  /// A partir daqui a foto é elegível a expurgo automático. Sem prazo, o custo
  /// de armazenamento de dado sensível cresce para sempre — e guardar rosto de
  /// cliente indefinidamente não se defende em auditoria nenhuma.
  retainUntil    DateTime
  createdAt      DateTime      @default(now())

  @@index([companyId, customerId])
  @@index([retainUntil])
  @@map("client_photo")
}

/// Ficha técnica do atendimento — o que foi feito, em números.
///
/// A proposta original era uma IA que "anotasse a ficha a partir da foto". Ela
/// não consegue: a fórmula da tintura não está na imagem, está na cabeça de
/// quem aplicou. O que funciona é campo estruturado com sugestão do que aquele
/// profissional já usou antes — mais rápido de preencher que ditar, e correto
/// por construção.
model ServiceRecord {
  id                String        @id @default(cuid())
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Um registro por atendimento. Dois seriam duas verdades sobre a mesma
  /// sessão, e no retorno ninguém saberia qual das duas foi aplicada.
  bookingId         String?       @unique
  booking           Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  professionalId    String?
  professional      Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  /// Fórmula da coloração (ex.: "7.1 + 9.3, 40g").
  formula           String?
  /// Oxidante / volume (ex.: "20 vol").
  developer         String?
  /// Tempo de pausa, em minutos.
  processingMinutes Int?
  /// Número da lâmina / pente (ex.: "2 nas laterais, 4 no topo").
  clipperGuard      String?
  /// Produtos usados, texto livre.
  productsUsed      String?
  notes             String?
  performedAt       DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([companyId, customerId])
  @@index([companyId, professionalId])
  @@map("service_record")
}

// ─── Reviews ──────────────────────────────────────────────────────────────────

model Review {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bookingId    String    @unique
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rating       Int // 1–5
  comment      String?
  reviewerName String? // customer name snapshot
  // Nota baixa vira alerta imediato ao gerente. O carimbo evita disparo
  // duplicado se a avaliação for reprocessada.
  alertSentAt  DateTime?
  // Origem: LINK (token assinado no e-mail) ou ACCOUNT (cliente logado).
  source       String    @default("ACCOUNT")
  createdAt    DateTime  @default(now())

  @@index([companyId])
  @@index([companyId, rating])
  @@map("review")
}

// ─── Push Tokens ──────────────────────────────────────────────────────────────

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  platform  String // "ios" | "android"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
  @@index([userId])
  @@map("push_token")
}

// ─── User Notification Preferences ───────────────────────────────────────────

model UserNotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enableEmail     Boolean  @default(true)
  enablePush      Boolean  @default(true)
  enableWhatsApp  Boolean  @default(false)
  enableSms       Boolean  @default(false)
  // Opt-in para e-mails de ofertas/promoções (padrão desligado — LGPD)
  enableMarketing Boolean  @default(false)
  whatsappPhone   String?
  smsPhone        String?
  updatedAt       DateTime @updatedAt

  @@map("user_notification_preference")
}

// ─── Promoções ────────────────────────────────────────────────────────────────

model Promotion {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  serviceTypeId String
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  description   String
  promoPrice    Decimal     @db.Decimal(10, 2)
  startDate     String // "YYYY-MM-DD"
  endDate       String // "YYYY-MM-DD"
  isActive      Boolean     @default(true)
  lastSentAt    DateTime? // último envio de e-mail marketing
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([companyId, isActive])
  @@index([serviceTypeId, startDate, endDate])
  @@map("promotion")
}

// ─── Company Payment Settings ─────────────────────────────────────────────────

// Formas de pagamento configuradas pela empresa — dados, não enum.
// MANUAL com label/handle livres cobre qualquer mercado (PIX por chave,
// Zelle, Venmo, Cash App, dinheiro…) sem mudança de código.
model CompanyPaymentMethod {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind         PaymentKind
  label        String // "Cartão", "PIX", "Zelle", "Venmo", "Dinheiro"…
  handle       String? // chave PIX, e-mail/telefone Zelle, @username Venmo
  instructions String? // instruções exibidas no checkout para métodos manuais
  isActive     Boolean     @default(true)
  displayOrder Int         @default(0)
  bookings     Booking[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([companyId, isActive])
  @@map("company_payment_method")
}

model CompanyPaymentSettings {
  id                     String   @id @default(cuid())
  companyId              String   @unique
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enableCard             Boolean  @default(true)
  enableCashCheck        Boolean  @default(true)
  enablePix              Boolean  @default(false)
  pixKey                 String?
  pixKeyType             String? // "cpf" | "cnpj" | "email" | "phone" | "random"
  requireDeposit         Boolean  @default(false)
  depositPercentage      Float    @default(30)
  // Sinal por faixa de confiança do cliente em vez de chave global.
  // Padrão desligado de propósito: ligar muda quanto os clientes pagam, e essa
  // troca é do dono — não pode ser efeito colateral de atualizar o sistema.
  // Ver `src/lib/trust-tier.ts`.
  dynamicDeposit         Boolean  @default(false)
  mercadoPagoAccessToken String? // encrypted
  updatedAt              DateTime @updatedAt

  @@map("company_payment_settings")
}

/**
 * Janela de horário ocioso com desconto ("Happy Hour").
 * A metade do yield management que vale a pena. O acréscimo no pico NÃO existe
 * e não deve ser adicionado — ver a nota em `src/lib/off-peak.ts`: desconto é
 * enquadrado como presente, acréscimo como punição, e em relação recorrente e
 * nominal a segunda leitura custa o cliente.
 * Diferente do ghost slot buster, que cobre a vaga que abriu agora: aqui é o
 * horário estruturalmente vazio, que se repete toda semana.
 */
model OffPeakWindow {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label              String
  /// 0 = domingo … 6 = sábado
  weekday            Int
  startTime          String // "HH:MM" inclusivo
  endTime            String // "HH:MM" exclusivo
  discountPercentage Float
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId, isActive])
  @@index([companyId, weekday])
  @@map("off_peak_window")
}

// ─── Agenda Exceptions ────────────────────────────────────────────────────────

model AgendaException {
  id        String              @id @default(cuid())
  agendaId  String
  agenda    Agenda              @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  date      String // "YYYY-MM-DD"
  type      AgendaExceptionType @default(BLOCKED_DAY)
  reason    String?
  startTime String? // only for CUSTOM_HOURS
  endTime   String? // only for CUSTOM_HOURS
  createdAt DateTime            @default(now())

  @@unique([agendaId, date])
  @@index([agendaId])
  @@map("agenda_exception")
}

// ─── Waitlist ─────────────────────────────────────────────────────────────────

model WaitlistEntry {
  id                 String         @id @default(cuid())
  companyId          String
  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agendaId           String
  agenda             Agenda         @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  bookingConfigId    String
  bookingConfig      BookingConfig  @relation(fields: [bookingConfigId], references: [id], onDelete: Cascade)
  preferredDate      String // "YYYY-MM-DD"
  preferredStartTime String? // "HH:MM"
  customerName       String
  customerEmail      String
  customerPhone      String?
  status             WaitlistStatus @default(WAITING)
  notifiedAt         DateTime?
  expiresAt          DateTime?
  createdAt          DateTime       @default(now())

  @@index([companyId, status])
  @@index([agendaId, preferredDate])
  @@map("waitlist_entry")
}

// ─── Outbound Webhooks ────────────────────────────────────────────────────────

model CompanyWebhook {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  url             String
  secret          String // HMAC-SHA256 signing secret
  events          WebhookEvent[]
  isActive        Boolean        @default(true)
  lastTriggeredAt DateTime?
  lastStatusCode  Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([companyId, isActive])
  @@map("company_webhook")
}

// ─── Calendar Integrations ────────────────────────────────────────────────────

model CalendarIntegration {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalId     String?
  provider           CalendarProvider
  accessToken        String? // AES-256-GCM encrypted (opcional para feeds ical)
  refreshToken       String? // AES-256-GCM encrypted
  expiresAt          DateTime?
  calendarId         String?
  externalIcalUrl    String? // URL de feed .ics / webcal externo
  syncExternalEvents Boolean          @default(true) // Bloquear horários ocupados no booking
  lastSyncedAt       DateTime?
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@index([professionalId])
  @@map("calendar_integration")
}

// ─── Super Admin System Presets por Nicho ─────────────────────────────────────

model SystemPreset {
  id           String   @id @default(cuid())
  businessType String
  title        String
  description  String?
  defaultPrice Decimal  @db.Decimal(10, 2)
  durationMin  Int      @default(30)
  isExtra      Boolean  @default(false)
  parentTitle  String? // Título do serviço pai se for um serviço extra
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessType, isActive])
  @@map("system_preset")
}

// ─── Super Admin Cadastro Dinâmico de Segmentos ───────────────────────────────

model SystemSegment {
  id           String   @id @default(cuid())
  code         String   @unique // ex: "MECHANIC", "BARBER", "DENTIST"
  label        String // ex: "🛠️ Oficina Mecânica & Auto"
  description  String? // ex: "Para oficinas, autocenters e funilarias"
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@map("system_segment")
}

// ─── Programa de Fidelidade & Pontos (Loyalty Program) ─────────────────────────

model LoyaltyProgram {
  id                String   @id @default(cuid())
  companyId         String   @unique
  isEnabled         Boolean  @default(true)
  pointsPerCurrency Decimal  @default(1.0) @db.Decimal(10, 2) // ex: 1 ponto por R$ 1,00
  rewardThreshold   Int      @default(100) // ex: 100 pontos = 1 voucher
  discountAmount    Decimal  @default(20.00) @db.Decimal(10, 2) // R$ 20,00 de desconto
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("loyalty_program")
}

model LoyaltyAccount {
  id            String   @id @default(cuid())
  companyId     String
  customerEmail String
  points        Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, customerEmail])
  @@index([companyId, customerEmail])
  @@map("loyalty_account")
}

// ─── Logs de Auditoria do Sistema (Audit Log) ──────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  userId    String?
  action    String // ex: "COMPANY_UPDATE", "SERVICE_RESET", "PLAN_CHANGE"
  entity    String // ex: "Company", "Service", "Subscription"
  details   String? // JSON string contendo detalhes da alteração
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@map("audit_log")
}

// ─── Notificações Internas do Sistema ─────────────────────────────────────────

model SystemNotification {
  id              String   @id @default(cuid())
  companyId       String?
  recipientUserId String? // Null para broadcast de Super Admin global
  title           String
  message         String
  type            String   @default("INFO") // PRESET_RESET_REQUEST | INFO | ALERT
  payload         String? // JSON string contendo companySlug, observation, etc.
  isRead          Boolean  @default(false)
  isResolved      Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([companyId])
  @@index([recipientUserId])
  @@index([isRead])
  @@map("system_notification")
}

model SystemModule {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String
  icon          String   @default("Tag")
  monthlyPrice  Decimal  @default(0) @db.Decimal(10, 2)
  lifetimePrice Decimal  @default(0) @db.Decimal(10, 2)
  billingType   String   @default("SUBSCRIPTION")
  category      String   @default("GROWTH")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@map("system_module")
}

model CompanyModuleLicense {
  id         String    @id @default(cuid())
  companyId  String
  moduleCode String
  status     String    @default("ACTIVE")
  expiresAt  DateTime?
  grantedAt  DateTime  @default(now())
  grantedBy  String    @default("SYSTEM")

  @@unique([companyId, moduleCode], map: "uniq_company_module")
  @@map("company_module_license")
}

model CompanyRole {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  isPreset    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("company_role")
}

// ─── Clube de Assinaturas & Pacotes de Sessões ──────────────────────────────────

model MembershipPlan {
  id                    String   @id @default(cuid())
  companyId             String
  name                  String
  description           String?
  price                 Decimal  @db.Decimal(10, 2)
  interval              String   @default("month") // month | quarter | year | one_time_package
  includedSessionsCount Int? // null = sessões ilimitadas no período, ou número fixo (ex: 4)
  discountPercent       Decimal? @default(0) @db.Decimal(5, 2)
  serviceIdsJson        String? // Array JSON de IDs de serviços cobertos ou null (todos)
  stripePriceId         String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships CustomerMembership[]

  @@index([companyId, isActive])
  @@map("membership_plan")
}

model CustomerMembership {
  id                   String    @id @default(cuid())
  companyId            String
  planId               String
  customerEmail        String
  customerName         String
  customerPhone        String?
  status               String    @default("ACTIVE") // ACTIVE | PAUSED | CANCELLED | EXPIRED
  startDate            DateTime  @default(now())
  renewsAt             DateTime?
  remainingSessions    Int? // Saldo de sessões restantes (decrementado a cada agendamento)
  stripeSubscriptionId String?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    MembershipPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  usages  MembershipUsage[]

  @@index([companyId, customerEmail])
  @@index([companyId, status])
  @@map("customer_membership")
}

model MembershipUsage {
  id                   String   @id @default(cuid())
  customerMembershipId String
  bookingId            String?
  serviceName          String
  usedAt               DateTime @default(now())
  notes                String?

  customerMembership CustomerMembership @relation(fields: [customerMembershipId], references: [id], onDelete: Cascade)

  @@index([customerMembershipId])
  @@map("membership_usage")
}

// ─── Gift Cards & Vales-Presente Digitais ─────────────────────────────────────

model GiftCard {
  id             String    @id @default(cuid())
  companyId      String
  code           String    @unique // ex: GIFT-8X9K-42M1
  initialBalance Decimal   @db.Decimal(10, 2)
  currentBalance Decimal   @db.Decimal(10, 2)
  currency       String    @default("BRL") // BRL, USD
  buyerName      String?
  buyerEmail     String?
  recipientName  String?
  recipientEmail String?
  recipientPhone String?
  message        String?
  status         String    @default("ACTIVE") // ACTIVE | EXHAUSTED | EXPIRED | CANCELLED
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  redemptions GiftCardRedemption[]

  @@index([companyId, status])
  @@index([companyId, code])
  @@map("gift_card")
}

model GiftCardRedemption {
  id         String   @id @default(cuid())
  giftCardId String
  bookingId  String?
  amount     Decimal  @db.Decimal(10, 2)
  redeemedAt DateTime @default(now())
  notes      String?

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@index([giftCardId])
  @@map("gift_card_redemption")
}

// ─── Produtos Físicos & Controle de Estoque ────────────────────────────────────

model Product {
  id                String   @id @default(cuid())
  companyId         String
  name              String
  sku               String? // Código de referência interno
  barcode           String? // Código de barras EAN/UPC
  costPrice         Decimal  @default(0) @db.Decimal(10, 2)
  salePrice         Decimal  @db.Decimal(10, 2)
  stockQuantity     Int      @default(0)
  minStockThreshold Int      @default(3) // Alerta de estoque baixo
  category          String? // Cabelo, Barba, Pele, Limpeza, etc.
  description       String?
  imageUrl          String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@index([companyId, isActive])
  @@index([companyId, category])
  @@map("product")
}

model StockMovement {
  id            String   @id @default(cuid())
  productId     String
  type          String // IN (Entrada/Compra), OUT (Saída/Ajuste), SALE (Venda POS), RETURN (Devolução)
  quantity      Int // Quantidade movimentada (positiva para IN/RETURN, negativa para OUT/SALE)
  previousStock Int
  newStock      Int
  reason        String? // Motivo da movimentação
  userId        String? // Usuário que registrou a movimentação
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("stock_movement")
}

// ─── Frente de Caixa / Comanda Rápida POS ─────────────────────────────────────

model PosSale {
  id               String   @id @default(cuid())
  companyId        String
  bookingId        String? // Agendamento vinculado
  professionalId   String? // Profissional vinculado para cálculo de comissão
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  subtotal         Decimal  @db.Decimal(10, 2)
  discountAmount   Decimal  @default(0) @db.Decimal(10, 2)
  total            Decimal  @db.Decimal(10, 2)
  // Ver a nota em `Estimate.currency`: moeda cobrada no ato da venda.
  currency         String? // ISO 4217
  paymentMethod    String   @default("CASH") // CASH | CARD_CREDIT | CARD_DEBIT | PIX | GIFT_CARD | MEMBERSHIP | MIXED
  status           String   @default("COMPLETED") // COMPLETED | REFUNDED | CANCELLED
  commissionAmount Decimal  @default(0) @db.Decimal(10, 2)
  notes            String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   SaleItem[]

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([companyId, currency])
  @@map("pos_sale")
}

model SaleItem {
  id               String  @id @default(cuid())
  saleId           String
  type             String  @default("PRODUCT") // PRODUCT | SERVICE | FEE
  productId        String?
  serviceId        String?
  name             String
  quantity         Int     @default(1)
  unitPrice        Decimal @db.Decimal(10, 2)
  totalPrice       Decimal @db.Decimal(10, 2)
  // Comissão deste item, com a taxa vigente NO ATO da venda.
  // `PosSale.commissionAmount` guarda só o total somado, o que impede o extrato
  // de separar serviço de produto — que é a dor inteira deste módulo. E
  // recalcular a partir da taxa atual reescreveria pagamentos já combinados:
  // mudar a comissão de um profissional alteraria o que ele recebeu no mês
  // passado.
  commissionAmount Decimal @default(0) @db.Decimal(10, 2)

  sale    PosSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  // O extrato agrupa comissão por tipo de item.
  @@index([type])
  @@map("sale_item")
}
